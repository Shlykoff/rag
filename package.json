    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "ai": "7.0.68",
    "googleapis": "^176.0.0",
    "jsdom": "^29.1.1",
    "next": "16.3.1",
    "openai": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "unpdf": "^1.7.0",
    "voyageai": "0.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",

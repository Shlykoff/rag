# Copy this file to .env.local for local development (`cp .env.example .env.local`)
# and fill in real values. Never commit .env.local or any file with real
# secrets -- see CLAUDE.md rule 1.

# --- Supabase -----------------------------------------------------------
# Local dev: run `supabase start` and copy the printed API URL / anon key /
# service_role key here (see README "Local development"). Production:
# use the hosted Supabase project's values (Vercel env vars), never these
# local ones.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only -- bypasses Row Level Security. Never expose to the
# client / never reference from a "use client" file. See
# lib/supabase/service-client.ts and CLAUDE.md rule 2.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider selection (lib/ai/index.ts) -----------------------------
# One of: openai | anthropic | gemini
# anthropic automatically pairs with Voyage for embeddings (Anthropic has
# no embeddings API of its own) -- see lib/ai/index.ts. Switching this
# value requires re-ingesting all documents (see README "Switching
# AI_PROVIDER"): different providers/models produce incompatible vector
# spaces even at the same 1024 dimensionality.
AI_PROVIDER=openai

# OpenAI (chat: gpt-4.1-mini by default; embeddings: text-embedding-3-small)
OPENAI_API_KEY=
# Optional overrides of the defaults in lib/ai/index.ts:
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (chat: claude-sonnet-4-5 by default)
ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Voyage AI (embeddings for AI_PROVIDER=anthropic; voyage-3-large by default)
VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-3-large

# Gemini (chat + embeddings via Google's OpenAI-compatible endpoint --
# see lib/ai/providers/gemini.ts. chat: gemini-2.5-flash by default;
# embeddings: gemini-embedding-001)
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Document sources (lib/sources/*, document-sources-specialist) ------
# Notion Internal Integration Secret. Per-user tokens are stored encrypted
# in `source_credentials` (see the migration's comment on the encryption
# plan) -- this env var, if set, is only a fallback/default for local
# development, not how the real per-user flow works. The real flow: create
# an internal integration at https://www.notion.so/my-integrations, POST
# its secret to /api/sources/credentials ({ sourceType: "notion",
# credential: "<secret>" }), then share the target page/database with that
# integration in Notion (Share -> Connections -> your integration) before
# calling /api/sources/notion.
NOTION_API_KEY=
# Google Cloud Service Account JSON (minified to one line), used to access
# a user-shared Google Drive folder. Same caveat as NOTION_API_KEY above --
# real per-user credentials live encrypted in `source_credentials`. The
# real flow: create a service account in Google Cloud Console, download its
# JSON key, POST the whole JSON (as one string) to /api/sources/credentials
# ({ sourceType: "google_drive", credential: "<json>" }), then share the
# target Drive folder with the service account's `client_email` (Viewer
# access) before calling /api/sources/google-drive.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google OAuth sign-in (supabase/config.toml's [auth.external.google]) ---
# Lets users sign in/up with their Google account, in addition to the
# existing email+password flow. Get these from Google Cloud Console ->
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# -> Application type "Web application". Add this exact Authorized
# redirect URI for local dev: http://127.0.0.1:54321/auth/v1/callback
# (add the equivalent hosted-project URL, e.g.
# https://<project-ref>.supabase.co/auth/v1/callback, before deploying).
# Leaving these empty is fine for local dev unrelated to Google sign-in --
# supabase/config.toml has the google provider enabled, but with an empty
# client_id the OAuth flow simply fails if someone actually clicks
# "Sign in with Google", it does not block `supabase start` or anything
# else.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Application-level encryption key for source_credentials
# (lib/sources/crypto.ts, AES-256-GCM) -- the Notion secret / Google service
# account JSON are encrypted with this key before ever touching the
# database, so a leaked DB dump alone can't recover them. MUST be exactly
# 32 bytes, hex-encoded (64 hex characters). Generate one with:
#   openssl rand -hex 32
# Losing/rotating this key makes every previously-stored credential
# undecryptable -- users would need to re-enter their Notion token / Google
# service account JSON. Never reuse the same key across environments
# (local/hosted) the way the local Supabase demo keys are reused.
CREDENTIALS_ENCRYPTION_KEY=

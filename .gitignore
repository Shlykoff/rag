# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- never commit real secrets. .env.example (placeholders only)
# is intentionally NOT ignored, see the negation below.
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local runtime state (not the migrations/config, which are tracked)
supabase/.branches
supabase/.temp

# scripts/run-seed-ai-credentials.mjs's ephemeral esbuild bundle -- written,
# run, and deleted by that script itself on every `npm run seed:ai-keys`;
# ignored here only as a safety net if the process is killed mid-run before
# its own cleanup (finally block) executes.
scripts/*.bundle.cjs
